<?php

/**
 * @file
 * Webform Guard Server module.
 */

/**
 * Implements hook_views_api().
 */
function webform_guard_server_views_api() {
  return array(
    'api' => 3,
    'path' => backdrop_get_path('module', 'webform_guard_server'),
  );
}

/**
 * Implements hook_config_info().
 */
function webform_guard_server_config_info() {
  $config['webform_guard_server.settings'] = array(
    'label' => 'Webform Guard Server settings',
    'group' => 'system',
  );

  return $config;
}

